{
    "extends": [
        "config:best-practices"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "matchCurrentVersion": "!/^0/",
            "automerge": true
        },
        {
            "description": "The chart's own image tag must stay empty so it defaults to appVersion",
            "matchManagers": [
                "helm-values"
            ],
            "matchPackageNames": [
                "neoskop/ixy"
            ],
            "enabled": false
        }
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "automergeType": "pr",
        "platformAutomerge": true
    },
    "assigneesFromCodeOwners": true,
    "assignAutomerge": false,
    "ignoreTests": true
}
